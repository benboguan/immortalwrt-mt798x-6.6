+		warp_dbg(WARP_DBG_ERR, "%s(): get wed slot from DTS fail!!\n", __func__);
 		warp_dbg(WARP_DBG_OFF, "%s(): assign default value: (0->1), (1->2)!!\n",
 			 __func__);
-		num = (idx == 0) ? 1 : 2;
+		goto set_default;
 	}
 	warp_dbg(WARP_DBG_OFF,
 		 "%s(): assign slot_id:%d for entry: %d!\n", __func__, num, idx);
+
+	of_node_put(node);
 	return (u8)num;
+set_default:
+	num = (idx == 0) ? 1 : 2;
+	if (node)
+		of_node_put(node);
+	return (u8)num;
 }
 
