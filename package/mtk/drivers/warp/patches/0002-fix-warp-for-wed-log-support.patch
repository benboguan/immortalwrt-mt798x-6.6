--- a/wed.c
+++ b/wed.c
@@ -1305,12 +1305,19 @@ wed_get_entry_num(void)
 	u32 num = 0;
 
 	node = of_find_compatible_node(NULL, NULL, WED_DEV_NODE);
+	if (!node) {
+		warp_dbg(WARP_DBG_ERR, "%s(): can't find compatible node [%s]\n",
