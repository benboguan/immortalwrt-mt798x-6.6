# l1profile configurations

menuconfig first_card
	bool "1st card"
	default y

if first_card

config first_card_name
	string "1st card name"
	default "MT7990" if MTK_WIFI7_CHIP_MT7990
	default "MT7992" if MTK_WIFI7_CHIP_MT7992
	default "MT7993" if MTK_WIFI7_CHIP_MT7993

config first_card_init_path
	string "init path"
	default "/etc/wireless/mediatek/mt7990.1.dat" if MTK_WIFI7_CHIP_MT7990
	default "/etc/wireless/mediatek/mt7992.1.dat" if MTK_WIFI7_CHIP_MT7992
	default "/etc/wireless/mediatek/mt7993.1.dat" if MTK_WIFI7_CHIP_MT7993

config first_card_profile_path
	string "profile path"
	default "/etc/wireless/mediatek/mt7990.b0.dat" if MTK_WIFI7_CHIP_MT7990
	default "/etc/wireless/mediatek/mt7992.b0.dat" if MTK_WIFI7_CHIP_MT7992
	default "/etc/wireless/mediatek/mt7993.b0.dat" if MTK_WIFI7_CHIP_MT7993

config first_card_init_script
	string "init scripts"
	default "/lib/wifi/mtwifi.lua"

config first_card_init_compatible
	string "this chip uses a compatible driver"
	default "mtwifi"

config first_card_EEPROM_offset
	string "eeprom data offset (in flash mode)"
	default "0x0"

config first_card_EEPROM_size
	string "eeprom data size (in flash mode)"
	default "0xf1000" if MTK_WIFI7_CHIP_MT7990
	default "0x15c800" if MTK_WIFI7_CHIP_MT7992
	default "0x14a800" if MTK_WIFI7_CHIP_MT7993

config first_card_EEPROM_name
	string "eeprom file name (request_firmware)"
	default "e2p"

config first_card_EEPROM_def_bin_path
	string "eeprom default bin file path (request_firmware)"
	default "/lib/firmware/MT7990_EEPROM_255_eFEM.bin" if MTK_WIFI7_CHIP_MT7990 && MTK_WIFI7_SKU_TYPE="BE13000_255"
	default "/lib/firmware/MT7990_EEPROM_iFEM233.bin" if MTK_WIFI7_CHIP_MT7990 && MTK_WIFI7_SKU_TYPE="BE14000"
	default "/lib/firmware/MT7990_EEPROM.bin" if MTK_WIFI7_CHIP_MT7990 && MTK_WIFI7_SKU_TYPE="BE19000"
	default "/lib/firmware/MT7992_EEPROM.bin" if MTK_WIFI7_CHIP_MT7992
	default "/lib/firmware/MT7993_EEPROM.bin" if MTK_WIFI7_CHIP_MT7993

config first_card_main_ifname
	string "primary interface name"
	default "ra0"

config first_card_ext_ifname
	string "interface prefix for multi-bssid"
	default "ra"

config first_card_wds_ifname
	string "WDS interface prefix"
	default "wds"

config first_card_apcli_ifname
	string "APCLI interface prefix"
	default "apcli"

config first_card_mesh_ifname
	string "MESH interface prefix"
	default "mesh"

config first_card_nvram_zone
	string "nvram zone"
	default "dev00"

config first_card_single_sku_path
	string "single SKU data path"
	default "/etc/wireless/mediatek/mt7990-sku.dat" if MTK_WIFI7_CHIP_MT7990
	default "/etc/wireless/mediatek/mt7992-sku.dat" if MTK_WIFI7_CHIP_MT7992
	default "/etc/wireless/mediatek/mt7993-sku.dat" if MTK_WIFI7_CHIP_MT7993

config first_card_bf_sku_path
	string "Beam forming SKU data path"
	default "/etc/wireless/mediatek/mt7990-sku-bf.dat" if MTK_WIFI7_CHIP_MT7990
	default "/etc/wireless/mediatek/mt7992-sku-bf.dat" if MTK_WIFI7_CHIP_MT7992
	default "/etc/wireless/mediatek/mt7993-sku-bf.dat" if MTK_WIFI7_CHIP_MT7993

endif



menuconfig second_card
	bool "2nd card"
	default y

if second_card

config second_card_name
	string "2st card name"
	default "MT7990" if MTK_WIFI7_CHIP_MT7990
	default "MT7992" if MTK_WIFI7_CHIP_MT7992
	default "MT7993" if MTK_WIFI7_CHIP_MT7993

config second_card_profile_path
	string "profile path"
	default "/etc/wireless/mediatek/mt7990.b1.dat" if MTK_WIFI7_CHIP_MT7990
	default "/etc/wireless/mediatek/mt7992.b1.dat" if MTK_WIFI7_CHIP_MT7992
	default "/etc/wireless/mediatek/mt7993.b1.dat" if MTK_WIFI7_CHIP_MT7993

config second_card_init_script
	string "init scripts"
	default "/lib/wifi/mtwifi.lua"

config second_card_init_compatible
	string "this chip uses a compatible driver"
	default "mtwifi"

config second_card_EEPROM_offset
	string "eeprom data offset (in flash mode)"
	default "0x0"

config second_card_EEPROM_size
	string "eeprom data size (in flash mode)"
	default "0xf1000" if MTK_WIFI7_CHIP_MT7990
	default "0x15c800" if MTK_WIFI7_CHIP_MT7992
	default "0x14a800" if MTK_WIFI7_CHIP_MT7993

config second_card_EEPROM_name
	string "eeprom file name (request_firmware)"
	default "e2p"

config second_card_EEPROM_def_bin_path
	string "eeprom default bin file path (request_firmware)"
	default "/lib/firmware/MT7990_EEPROM_255_eFEM.bin" if MTK_WIFI7_CHIP_MT7990 && MTK_WIFI7_SKU_TYPE="BE13000_255"
	default "/lib/firmware/MT7990_EEPROM_iFEM233.bin" if MTK_WIFI7_CHIP_MT7990 && MTK_WIFI7_SKU_TYPE="BE14000"
	default "/lib/firmware/MT7990_EEPROM.bin" if MTK_WIFI7_CHIP_MT7990 && MTK_WIFI7_SKU_TYPE="BE19000"
	default "/lib/firmware/MT7992_EEPROM.bin" if MTK_WIFI7_CHIP_MT7992
	default "/lib/firmware/MT7993_EEPROM.bin" if MTK_WIFI7_CHIP_MT7993

config second_card_main_ifname
	string "primary interface name"
	default "rai0"

config second_card_ext_ifname
	string "interface prefix for multi-bssid"
	default "rai"

config second_card_wds_ifname
	string "WDS interface prefix"
	default "wdsi"

config second_card_apcli_ifname
	string "APCLI interface prefix"
	default "apclii"

config second_card_mesh_ifname
	string "MESH interface prefix"
	default "meshi"

config second_card_nvram_zone
	string "nvram zone"
	default "dev01"

config second_card_single_sku_path
	string "single SKU data path"
	default "/etc/wireless/mediatek/mt7990-sku.dat" if MTK_WIFI7_CHIP_MT7990
	default "/etc/wireless/mediatek/mt7992-sku.dat" if MTK_WIFI7_CHIP_MT7992
	default "/etc/wireless/mediatek/mt7993-sku.dat" if MTK_WIFI7_CHIP_MT7993

config second_card_bf_sku_path
	string "Beam forming SKU data path"
	default "/etc/wireless/mediatek/mt7990-sku-bf.dat" if MTK_WIFI7_CHIP_MT7990
	default "/etc/wireless/mediatek/mt7992-sku-bf.dat" if MTK_WIFI7_CHIP_MT7992
	default "/etc/wireless/mediatek/mt7993-sku-bf.dat" if MTK_WIFI7_CHIP_MT7993

endif


menuconfig third_card
	bool "3rd card"
	default y

if third_card

config third_card_name
	string "3rd card name"
	default "MT7990" if MTK_WIFI7_CHIP_MT7990

config third_card_profile_path
	string "profile path"
	default "/etc/wireless/mediatek/mt7990.b2.dat" if MTK_WIFI7_CHIP_MT7990

config third_card_init_script
	string "init scripts"
	default "/lib/wifi/mtwifi.lua"

config third_card_init_compatible
	string "this chip uses a compatible driver"
	default "mtwifi"

config third_card_EEPROM_offset
	string "eeprom data offset (in flash mode)"
	default "0x0"

config third_card_EEPROM_size
	string "eeprom data size (in flash mode)"
	default "0xf1000" if MTK_WIFI7_CHIP_MT7990

config third_card_EEPROM_name
	string "eeprom file name (request_firmware)"
	default "e2p"

config third_card_EEPROM_def_bin_path
	string "eeprom default bin file path (request_firmware)"
	default "/lib/firmware/MT7990_EEPROM_255_eFEM.bin" if MTK_WIFI7_CHIP_MT7990 && MTK_WIFI7_SKU_TYPE="BE13000_255"
	default "/lib/firmware/MT7990_EEPROM_iFEM233.bin" if MTK_WIFI7_CHIP_MT7990 && MTK_WIFI7_SKU_TYPE="BE14000"
	default "/lib/firmware/MT7990_EEPROM.bin" if MTK_WIFI7_CHIP_MT7990 && MTK_WIFI7_SKU_TYPE="BE19000"

config third_card_main_ifname
	string "primary interface name"
	default "rax0"

config third_card_ext_ifname
	string "interface prefix for multi-bssid"
	default "rax"

config third_card_wds_ifname
	string "WDS interface prefix"
	default "wdsx"

config third_card_apcli_ifname
	string "APCLI interface prefix"
	default "apclix"

config third_card_mesh_ifname
	string "MESH interface prefix"
	default "meshx"

config third_card_nvram_zone
	string "nvram zone"
	default "dev02"

config third_card_single_sku_path
	string "single SKU data path"
	default "/etc/wireless/mediatek/mt7990-sku.dat" if MTK_WIFI7_CHIP_MT7990

config third_card_bf_sku_path
	string "Beam forming SKU data path"
	default "/etc/wireless/mediatek/mt7990-sku-bf.dat" if MTK_WIFI7_CHIP_MT7990

endif

choice
	prompt "WiFi Setting"
	default WIFI_NORMAL_SETTING
	config WIFI_NORMAL_SETTING
		bool "normal setting"

	config WIFI_QUICK_SETTING
		bool "quick setting"

	help
		This is a way to configure wifi after wifi reload(Save & Apply from UI).
		Normal setting means reloading dat file which will execute "wifi down; wifi up"
		Quick setting means executing iwpriv commands corresponding to your operation on UI.
endchoice

config WIFI_SCRIPT_SUPPORT
	bool "wifi script support"
	default n
