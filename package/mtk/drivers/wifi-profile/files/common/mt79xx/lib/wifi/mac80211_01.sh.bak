#!/bin/sh
append DRIVERS "mac80211"

check_mac80211_device() {
	local device="$1"
	local path="$2"
	local macaddr="$3"
	[ -n "$found" ] && return 0
	phy_path=
	config_get phy "$device" phy
	json_select wlan
	[ -n "$phy" ] && case "$phy" in
		phy*)
			[ -d /sys/class/ieee80211/$phy ] && \
				phy_path="$(iwinfo nl80211 path "$dev")"
		;;
		*)
			if json_is_a "$phy" object; then
				json_select "$phy"
				json_get_var phy_path path
				json_select ..
			elif json_is_a "${phy%.*}" object; then
				json_select "${phy%.*}"
				json_get_var phy_path path
				json_select ..
				phy_path="$phy_path+${phy##*.}"
			fi
		;;
	esac
	json_select ..
	[ -n "$phy_path" ] || config_get phy_path "$device" path
	[ -n "$path" -a "$phy_path" = "$path" ] && { found=1; return 0; }
	config_get dev_macaddr "$device" macaddr
	[ -n "$macaddr" -a "$dev_macaddr" = "$macaddr" ] && found=1
	return 0
}

__get_band_defaults() {
	local phy="$1"
	( iw phy "$phy" info; echo ) | awk '
BEGIN { bands="" }
$1=="Band"||$1==""&&band {
	if (channel) {
		mode="NOHT"
		if (ht) mode="HT20"
		if (vht && band != "1:") mode="VHT80"
		if (he) mode="HE80"
		if (he && band == "1:") mode="HE20"
		if (eht) mode="EHT80"
		if (eht && band == "1:") mode="EHT20"
		sub("\\[", "", channel)
		sub("\\]", "", channel)
		bands = bands band channel ":" mode " "
	}
	band=""
}
$1=="Band"{band=$2;channel="";vht="";ht="";he="";eht=""}
$0~"Capabilities:"{ht=1}
$0~"VHT Capabilities"{vht=1}
$0~"HE Iftypes"{he=1}
$0~"EHT Iftypes"{eht=1}
$1=="*"&&$3=="MHz"&&$0!~/disabled/&&band&&!channel{channel=$4}
END{print bands}'
}

get_band_defaults() {
	local phy="$1"
	for c in $(__get_band_defaults "$phy"); do
		local band="${c%%:*}"
		c="${c#*:}"
		local chan="${c%%:*}"
		c="${c#*:}"
		local mode="${c%%:*}"
		case "$band" in
			1) band=2g;; 2) band=5g;; 3) band=60g;; 4) band=6g;; *) band="";;
		esac
		[ -n "$band" ] || continue
		[ -n "$mode_band" -a "$band" = "6g" ] && return
		mode_band="$band"
		channel="$chan"
		htmode="$mode"
	done
}

check_devidx() {
	case "$1" in
		radio[0-9]*) local idx="${1#radio}"; [ "$devidx" -ge "$idx" ] && devidx=$((idx+1));;
	esac
}

check_board_phy() {
	local name="$2"
	json_select "$name"
	json_get_var phy_path path
	json_select ..
	[ "$path" = "$phy_path" ] && board_dev="$name"
	[ "${path%+*}" = "$phy_path" ] && fallback_board_dev="$name.${path#*+}"
}

detect_mac80211() {
	devidx=0
	config_load wireless
	config_foreach check_devidx wifi-device

	[ -n "$(uci -q show wireless | grep wifi-device)" ] && return

	uci -q delete wireless

	local assocresp_elements="dd07000ce700000000"
	local device_list=""

	for _dev in /sys/class/ieee80211/*; do
		[ -e "$_dev" ] || continue
		dev="${_dev##*/}"
		mode_band="" channel="" htmode=""
		get_band_defaults "$dev"
		path="$(iwinfo nl80211 path "$dev")"
		board_dev= fallback_board_dev=
		json_for_each_item check_board_phy wlan
		board_dev="${board_dev:-$fallback_board_dev}"
		[ -n "$board_dev" ] && dev="$board_dev"
		found= config_foreach check_mac80211_device wifi-device "$path"
		[ -n "$found" ] && continue

		name="radio$devidx"
		devidx=$((devidx+1))

		case "$dev" in
			phy2)
				band="6g"
				htmode="EHT320"
				channel=37
				ssid="ImmortalWrt_6G"
				encryption="sae"
				key="12345678"
				mbo=1 mbssid=1
				has_6g=1 has_mlo=1
				;;
			phy1)
				band="5g"
				htmode="EHT160"
				channel=36
				ssid="ImmortalWrt_5G"
				encryption="none"
				key=""
				mbo=0 rnr=1 background_radar=1
				has_mlo=1
				;;
			phy0|*)
				band="2g"
				htmode="EHT40"
				channel=6
				ssid="ImmortalWrt_2.4G"
				encryption="none"
				key=""
				mbo=0 rnr=1
				has_mlo=1
				;;
		esac

		uci batch <<-EOF
			set wireless.$name=wifi-device
			set wireless.$name.type=mac80211
			set wireless.$name.phy=$phy
			set wireless.$name.path=$path
			set wireless.$name.band=$band
			set wireless.$name.channel=$channel
			set wireless.$name.htmode=$htmode
			set wireless.$name.country=US
			set wireless.$name.disabled=0
			set wireless.$name.noscan=0
			set wireless.$name.mbssid=$mbssid
			set wireless.$name.tx_burst=0.0
			set wireless.$name.rnr=$rnr
			set wireless.default_$name=wifi-iface
			set wireless.default_$name.device=$name
			set wireless.default_$name.network=lan
			set wireless.default_$name.mode=ap
			set wireless.default_$name.ssid=$ssid
			set wireless.default_$name.encryption=$encryption
			set wireless.default_$name.key=$key
			set wireless.default_$name.mbo=$mbo
			set wireless.default_$name.assocresp_elements=$assocresp_elements
		EOF

		[ "$encryption" = "sae" ] && uci batch <<-EOF
			set wireless.default_$name.sae_pwe=2
			set wireless.default_$name.ieee80211w=2
		EOF

		device_list="$device_list $name"
	done

	# MLD
	if [ "$has_mlo" = 1 ] && [ -n "$device_list" ]; then
		uci set wireless.ap_mld_1=wifi-mld
		for dev in $device_list; do
			uci add_list wireless.ap_mld_1.device=$dev
		done

		uci batch <<-EOF
			set wireless.ap_mld_1.ifname=ap-mld-1
			set wireless.ap_mld_1.network=lan
			set wireless.ap_mld_1.mode=ap
			set wireless.ap_mld_1.mlo=1
			set wireless.ap_mld_1.mld_id=1
			set wireless.ap_mld_1.ssid=ImmortalWrt_MLO
			set wireless.ap_mld_1.encryption=sae
			set wireless.ap_mld_1.key=12345678
			set wireless.ap_mld_1.sae_pwe=2
			set wireless.ap_mld_1.ieee80211w=2
			set wireless.ap_mld_1.assocresp_elements=$assocresp_elements
		EOF
	fi

	uci commit wireless
}
