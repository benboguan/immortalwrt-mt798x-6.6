INDEX0_init_script=/lib/wifi/mtwifi.lua
INDEX0_init_compatible=mtwifi
INDEX0_EEPROM_offset=0x0
INDEX0_EEPROM_size=0xf1000
INDEX0_EEPROM_name=e2p
INDEX0_EEPROM_def_bin_path=/lib/firmware/MT7990_EEPROM_iFEM233.bin
INDEX0_main_ifname=phy0-ap0;phy1-ap0;phy2-ap0
INDEX0_ext_ifname=phy0-ap;phy1-ap;phy2-ap
INDEX0_wds_ifname=phy0-wds;phy1-wds;phy2-wds
INDEX0_apcli_ifname=phy0-sta;phy1-sta;phy2-sta
INDEX0_mesh_ifname=phy0-mesh;phy1-mesh;phy2-mesh
INDEX0_nvram_zone=dev00;dev01;dev02
INDEX0_single_sku_path=/etc/wireless/mediatek/mt7990-sku.dat
INDEX0_bf_sku_path=/etc/wireless/mediatek/mt7990-sku-bf.dat
INDEX1=MT7990                                                      
INDEX1_profile_path=/etc/wireless/mediatek/mt7990.b2.dat
INDEX1_init_script=/lib/wifi/mtwifi.lua                 
