Index: mt_wifi7/mt_wifi/os/linux/cfg80211/cfg80211_scan.c
===================================================================
--- mt_wifi7.orig/mt_wifi/os/linux/cfg80211/cfg80211_scan.c
+++ mt_wifi7/mt_wifi/os/linux/cfg80211/cfg80211_scan.c
@@ -198,6 +198,7 @@ void CFG80211DRV_ApcliSiteSurvey(
 	CFG80211_CB *pCfg80211_CB;
 	SCAN_CTRL *ScanCtrl;
 	struct wifi_dev *wdev = NULL;
+	PSTA_ADMIN_CONFIG StaCfg = NULL;
 
 	pCfg80211_CB = pAd->pCfg80211_CB;
 
@@ -216,6 +217,7 @@ void CFG80211DRV_ApcliSiteSurvey(
 	if (ScanType == SCAN_PARTIAL) {
 		wdev = &pAd->StaCfg[pScan->StaIndex].wdev;
 		ScanCtrl = get_scan_ctrl_by_wdev(pAd, wdev);
+		StaCfg = GetStaCfgByWdev(pAd, wdev);
 		MTWF_DBG(pAd, DBG_CAT_CFG, CATCFG_CMD, DBG_LVL_ERROR,
 				"Trigger Partial scan(%d).\n", __LINE__);		
 		if (ScanCtrl->PartialScan.bScanning) {
@@ -227,6 +229,20 @@ void CFG80211DRV_ApcliSiteSurvey(
 		ScanCtrl->PartialScan.pwdev = wdev;
 		wdev->ScanInfo.LastScanChannel = 0;
 		ScanCtrl->PartialScan.bScanning = TRUE;
+
+		if (Ssid.SsidLength) {
+			ScanCtrl->SsidLen = Ssid.SsidLength;
+			NdisMoveMemory(ScanCtrl->Ssid, &Ssid.SsidLength, Ssid.SsidLength);
+		} else if (StaCfg && !INFRA_ON(StaCfg)
+				&& !(STA_STATUS_TEST_FLAG(StaCfg, fSTA_STATUS_MEDIA_STATE_CONNECTED))) {
+			ScanCtrl->SsidLen = StaCfg->CfgSsidLen;
+			if(StaCfg->CfgSsidLen)
+				memcpy(ScanCtrl->Ssid, StaCfg->CfgSsid, StaCfg->CfgSsidLen);
+			MTWF_DBG(NULL, DBG_CAT_CHN, CATCHN_SCAN, DBG_LVL_ERROR,
+					"CFG_SCAN:%d %s SSID:(%d:%s)\n", __LINE__, __func__,
+					ScanCtrl->SsidLen, ScanCtrl->Ssid);
+		}
+
 	} else
 		StaSiteSurvey(pAd, &Ssid, ScanType, &pAd->StaCfg[pScan->StaIndex].wdev);
 }
