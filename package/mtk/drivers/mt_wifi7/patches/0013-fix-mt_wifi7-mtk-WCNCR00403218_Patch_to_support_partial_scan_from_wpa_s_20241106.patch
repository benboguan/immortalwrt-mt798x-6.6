Index: mt_wifi7/mt_wifi/os/linux/cfg80211/cfg80211_scan.c
===================================================================
--- mt_wifi7.orig/mt_wifi/os/linux/cfg80211/cfg80211_scan.c
+++ mt_wifi7/mt_wifi/os/linux/cfg80211/cfg80211_scan.c
@@ -196,6 +196,8 @@ void CFG80211DRV_ApcliSiteSurvey(
 	NDIS_802_11_SSID	Ssid;
 	UCHAR ScanType = SCAN_ACTIVE;
 	CFG80211_CB *pCfg80211_CB;
+	SCAN_CTRL *ScanCtrl;
+	struct wifi_dev *wdev = NULL;
 
 	pCfg80211_CB = pAd->pCfg80211_CB;
 
@@ -210,7 +212,23 @@ void CFG80211DRV_ApcliSiteSurvey(
 	NdisZeroMemory(&Ssid.Ssid, NDIS_802_11_LENGTH_SSID);
 	if (pScan->SsidLen)
 		NdisMoveMemory(Ssid.Ssid, pScan->pSsid, Ssid.SsidLength);
-	StaSiteSurvey(pAd, &Ssid, ScanType, &pAd->StaCfg[pScan->StaIndex].wdev);
+
+	if (ScanType == SCAN_PARTIAL) {
+		wdev = &pAd->StaCfg[pScan->StaIndex].wdev;
+		ScanCtrl = get_scan_ctrl_by_wdev(pAd, wdev);
+		MTWF_DBG(pAd, DBG_CAT_CFG, CATCFG_CMD, DBG_LVL_ERROR,
+				"Trigger Partial scan(%d).\n", __LINE__);		
+		if (ScanCtrl->PartialScan.bScanning) {
+			MTWF_DBG(pAd, DBG_CAT_CFG, CATCFG_CMD, DBG_LVL_ERROR,
+					"partial scan is under process is under process."
+					" cannot trigger new partial scan\n");
+			return;
+		}
+		ScanCtrl->PartialScan.pwdev = wdev;
+		wdev->ScanInfo.LastScanChannel = 0;
+		ScanCtrl->PartialScan.bScanning = TRUE;
+	} else
+		StaSiteSurvey(pAd, &Ssid, ScanType, &pAd->StaCfg[pScan->StaIndex].wdev);
 }
 #endif /* APCLI_CFG80211_SUPPORT */
 
