msgid "EasyMesh"
msgstr "EasyMesh"

msgid "Basic Settings"
msgstr "基础设置"

msgid "Onboarding"
msgstr "入网引导"

msgid "Status"
msgstr "运行状态"

msgid "clients"
msgstr "客户端"

msgid "MediaTek MAP Turnkey. The device role, channel planning and client steering settings below are stored in /etc/config/mapd."
msgstr "MediaTek MAP Turnkey。以下设备角色、信道规划与客户端引导设置保存在 /etc/config/mapd 中。"

msgid "General"
msgstr "常规"

msgid "Enable EasyMesh"
msgstr "启用 EasyMesh"

msgid "Work Mode"
msgstr "工作模式"

msgid "Router"
msgstr "路由"

msgid "Bridge"
msgstr "桥接"

msgid "Device role"
msgstr "设备角色"

msgid "Auto"
msgstr "自动"

msgid "Controller"
msgstr "控制器"

msgid "Agent"
msgstr "代理节点"

msgid "Changing the role requires a restart of the EasyMesh daemons."
msgstr "修改角色后需要重启 EasyMesh 守护进程。"

msgid "MAP version"
msgstr "MAP 版本"

msgid "All devices in the mesh must use the same MAP version. Use R3 for MAP R4 capable devices, DPP onboarding requires R3."
msgstr "同一 Mesh 内所有设备必须使用相同的 MAP 版本。支持 MAP R4 的设备请使用 R3，DPP 入网需要 R3。"

msgid "AP steering RSSI threshold"
msgstr "AP 引导 RSSI 阈值"

msgid "Minimum RSSI (dBm) below which the controller considers steering a client."
msgstr "低于该 RSSI (dBm) 时控制器会考虑引导客户端。"

msgid "Client steering"
msgstr "客户端引导"

msgid "Centralized steering of clients between the mesh devices."
msgstr "在 Mesh 设备之间集中引导客户端。"

msgid "2.4 GHz channel load limit"
msgstr "2.4 GHz 信道负载上限"

msgid "Channel utilisation (%) above which the band counts as overloaded."
msgstr "信道利用率（%）超过此值时，该频段视为过载。"

msgid "5 GHz low channel load limit"
msgstr "5 GHz 低频段信道负载上限"

msgid "5 GHz high channel load limit"
msgstr "5 GHz 高频段信道负载上限"

msgid "Backhaul"
msgstr "回程"

msgid "2.4 GHz backhaul priority"
msgstr "2.4 GHz 回程优先级"

msgid "Never"
msgstr "从不"

msgid "Highest"
msgstr "最高"

msgid "Medium"
msgstr "中等"

msgid "Lowest"
msgstr "最低"

msgid "5 GHz low backhaul priority"
msgstr "5 GHz 低频段回程优先级"

msgid "5 GHz high backhaul priority"
msgstr "5 GHz 高频段回程优先级"

msgid "6 GHz backhaul priority"
msgstr "6 GHz 回程优先级"

msgid "Automatic Ethernet / Wi-Fi backhaul switching"
msgstr "自动切换以太网 / Wi-Fi 回程"

msgid "Agents fall back to a wireless backhaul when the Ethernet link goes down."
msgstr "当以太网链路断开时，代理节点将回退到无线回程。"

msgid "Advanced"
msgstr "高级"

msgid "Network optimization"
msgstr "网络优化"

msgid "Periodically re-evaluates the backhaul link of every agent. Disable it before triggering a backhaul steer or a band switch."
msgstr "定期重新评估每个代理节点的回程链路。在触发回程引导或频段切换前请先禁用。"

msgid "Optimization delay after join"
msgstr "加入后的优化延迟"

msgid "Seconds to wait after a new device joins before evaluating the backhaul."
msgstr "新设备加入后等待多少秒再评估回程。"

msgid "Optimization delay after leave"
msgstr "离开后的优化延迟"

msgid "Seconds to wait after a device leaves before evaluating the backhaul."
msgstr "设备离开后等待多少秒再评估回程。"

msgid "Backhaul retry delay"
msgstr "回程重试延迟"

msgid "Seconds before retrying a higher priority backhaul, 0 to never retry."
msgstr "重试更高优先级回程前的等待秒数，0 表示不重试。"

msgid "Prefer 5 GHz backhaul"
msgstr "优先使用 5 GHz 回程"

msgid "Force a backhaul re-evaluation when an agent stays on 2.4 GHz."
msgstr "当代理节点停留在 2.4 GHz 时强制重新评估回程。"

msgid "Automatic channel planning"
msgstr "自动信道规划"

msgid "The controller moves all agents to a common channel per band."
msgstr "控制器将全部代理节点移动到每个频段的公共信道。"

msgid "Preferred 2.4 GHz channel"
msgstr "首选 2.4 GHz 信道"

msgid "Leave empty for automatic selection."
msgstr "留空表示自动选择。"

msgid "Preferred 5 GHz channel"
msgstr "首选 5 GHz 信道"

msgid "Channel planning idle time"
msgstr "信道规划空闲时间"

msgid "Seconds without traffic before channel planning may run again."
msgstr "无流量持续多少秒后允许再次运行信道规划。"

msgid "DHCP control"
msgstr "DHCP 控制"

msgid "The controller manages the DHCP server setting of its agents."
msgstr "控制器管理其代理节点的 DHCP 服务器设置。"

msgid "EasyMesh status"
msgstr "EasyMesh 状态"

msgid "Runtime state of the MAP Turnkey daemons and of the current mesh."
msgstr "MAP Turnkey 守护进程与当前 Mesh 的运行状态。"

msgid "Overview"
msgstr "概览"

msgid "State"
msgstr "状态"

