msgstr "驱动配置"

msgid "No wireless device"
msgstr "没有无线设备"

msgid "No wifi-device section found in /etc/config/wireless. Driver MAP parameters cannot be configured here."
msgstr "/etc/config/wireless 中未找到 wifi-device section，无法在此配置驱动 MAP 参数。"

