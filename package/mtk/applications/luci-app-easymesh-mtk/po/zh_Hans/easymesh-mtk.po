msgstr "添加 DPP URI 并启动"

msgid "Restart"
msgstr "重启"

msgid "Re-run the MAP Turnkey bring-up script. Required after a device role or MAP version change, and after changing more than four MBSS."
msgstr "重新运行 MAP Turnkey 启动脚本。在修改设备角色或 MAP 版本后，以及修改超过四个 MBSS 后必须执行。"

msgid "Restart EasyMesh"
msgstr "重启 EasyMesh"

msgid "WPS push button started on %s."
msgstr "已在 %s 上启动 WPS 按钮。"

msgid "DPP bootstrap URI retrieved, copy it to the controller."
msgstr "已获取 DPP 引导 URI，请将其复制到控制器。"

msgid "DPP onboarding started on the controller."
msgstr "已在控制器上启动 DPP 入网。"

msgid "EasyMesh daemons are restarting, this may take a few seconds."
msgstr "EasyMesh 守护进程正在重启，可能需要几秒钟。"

msgid "DPP presence band updated."
msgstr "DPP 存在通告频段已更新。"

msgid "Paste a DPP URI (starting with \"DPP:\") first."
msgstr "请先粘贴一个以“DPP:”开头的 DPP URI。"

