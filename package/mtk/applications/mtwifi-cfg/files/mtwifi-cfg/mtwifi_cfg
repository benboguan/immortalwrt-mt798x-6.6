function string:split(sep)
    local sep, fields = sep or ":", {}
    local pattern = string.format("([^%s]+)", sep)
    self:gsub(pattern, function(c) fields[#fields+1] = c end)
    return fields
end

function save_profile(cfgs, path)
    if not cfgs then
        nixio.syslog("err", "configuration was empty, nothing saved")
        return false
    end

    local datobj = datconf.openfile(path)
    datobj:merge(cfgs)
    local ok = datobj:close(true)
    if not ok then
        nixio.syslog("err", "mtwifi-cfg: failed to save profile " .. tostring(path))
        return false
    end
    os.execute("sync")
    return true
end

function diff_cfg(cfg1, cfg2)
    local diff = {}

    for k,v in pairs(cfg1) do
        if tostring(cfg2[k]) ~= tostring(cfg1[k]) then
            diff[k] = {cfg1[k] or "", cfg2[k] or ""}
        end
    end

    for k,v in pairs(cfg2) do
        if tostring(cfg2[k]) ~= tostring(cfg1[k]) then
            diff[k] = {cfg1[k] or "", cfg2[k] or ""}
        end
    end

    return diff
end

function is_dbdc_inited(ifname)
    local mac = utils.trim(utils.read_pipe("cat /sys/class/net/"..ifname.."/address 2>/dev/null"))
    return mac and mac ~= "00:00:00:00:00:00"
end

-- ============================================================
-- cfg80211
-- ============================================================
function is_cfg80211_enabled(ifname)
    if ifname and utils.exists("/sys/class/net/" .. ifname .. "/phy80211") then
        return true
    end
    return false
end

function get_phy_name(ifname)
    local f = io.open("/sys/class/net/" .. ifname .. "/phy80211/name", "r")
    if not f then return nil end
    local name = f:read("*a")
    f:close()
    if name and #name > 0 then
        return name:gsub("%s+$", "")
    end
    return nil
end

-- ============================================================
-- WPS iface 映射
-- 把驱动接口名（ra0/ra1/rai0/rai1/apcli0/...）映射到 UCI section 名
-- （default_MT7992_1_1 / wifinetN），供 hostapd_wps_er_action.lua 使用。
-- ============================================================
local function load_iface_wps()
    local m = {}
    local f = io.open(IFACE_WPS_FILE, "r")
    if f then
        for line in f:lines() do
            local ifn, sec = line:match("^(%S+)%s+(%S+)$")
            if ifn and sec then
                m[ifn] = sec
            end
        end
        f:close()
    end
    return m
end

local function save_iface_wps(m)
    local keys = {}
    for ifn, _ in pairs(m) do
        table.insert(keys, ifn)
    end
    table.sort(keys)

    local f = io.open(IFACE_WPS_FILE, "w")
    if not f then return end
    for _, ifn in ipairs(keys) do
        f:write(ifn, " ", m[ifn], "\n")
    end
    f:close()
end

local function update_iface_wps(cfg)
    if not cfg or not cfg.interfaces then return end

    local m = load_iface_wps()

    -- 收集当前 radio 的 vif 前缀
    local devname = cfg.device
    local dev = l1dat.devname_ridx[devname]
    if not dev then return end

    local prefixes = {
        dev.main_ifname,        -- ra0 / rai0
        dev.ext_ifname,         -- ra / rai
        dev.apcli_ifname,       -- apcli / apclii
        dev.wds_ifname,         -- wds / wdsi
        dev.mesh_ifname,        -- mesh / meshi
    }

    -- 删掉属于当前 radio 的所有旧映射
    for ifn, _ in pairs(m) do
        for _, p in ipairs(prefixes) do
            if p and #p > 0 and ifn:sub(1, #p) == p then
                m[ifn] = nil
                break
            end
        end
    end

    -- 加入当前 interfaces
    for section, v in pairs(cfg.interfaces) do
        if v and v.mtwifi_ifname then
            m[v.mtwifi_ifname] = section
        end
    end

    save_iface_wps(m)
end

-- ============================================================
-- mgmt_rx
-- ============================================================
function mtwifi_set_mgmt_rx(devname, value)
    local targets = {}
    if devname then
        local dev = l1dat.devname_ridx[devname]
        if dev and dev.main_ifname then
            table.insert(targets, dev.main_ifname)
        end
    else
        for _, dev in pairs(l1dat.devname_ridx) do
            if dev.main_ifname then
                table.insert(targets, dev.main_ifname)
            end
        end
    end
    for _, ifname in ipairs(targets) do
        os.execute("mwctl "..ifname.." set mgmt_rx "..tostring(value))
        nixio.syslog("info", "mtwifi-cfg: mgmt_rx "..tostring(value).." on "..ifname)
    end
end

function mtwifi_set_mgmt_rx_accept_all(devname)
    mtwifi_set_mgmt_rx(devname, 0)
end

function mtwifi_set_mgmt_rx_accept_beacon_probrsp(devname)
    mtwifi_set_mgmt_rx(devname, 1)
end

-- ============================================================
-- MLO beacon
-- ============================================================
local function dat_no_bcn_is_1(profile_path)
    if not profile_path then return false end
    local f = io.open(profile_path, "r")
    if not f then return false end
    local is1 = false
    for line in f:lines() do
        if line:match("^%s*no_bcn%s*=%s*1") then
            is1 = true
            break
        end
    end
    f:close()
    return is1
end

function mtwifi_set_mld_bcn(cfg, value)
    if not cfg or not cfg.interfaces then return end
    for _, v in pairs(cfg.interfaces) do
        if v.config and v.mtwifi_ifname then
            local n = tonumber(tostring(v.config.mldgroup or "0"))
            if n and n ~= 0 and n < 17 then
                os.execute("mwctl "..v.mtwifi_ifname.." set no_bcn "..value)
                nixio.syslog("info", "mtwifi-cfg: set no_bcn "..value.." for "..v.mtwifi_ifname)
            end
        end
    end
end

function mtwifi_set_mld_bcn_down(cfg)
    mtwifi_set_mld_bcn(cfg, "1")
end

function mtwifi_set_mld_bcn_up(cfg)
    local dev = l1dat.devname_ridx[cfg.device]
    if dev and dat_no_bcn_is_1(dev.profile_path) then
        nixio.syslog("info", "mtwifi-cfg: no_bcn=1 in dat, skip bcn_up")
        return
    end
    mtwifi_set_mld_bcn(cfg, "0")
end

-- PHY-level (driver) hairpin_mode. This is RADIO-GLOBAL: it forwards
-- same-radio STA<->STA frames inside the WiFi MAC. Do NOT combine this
-- with linux bridge port hairpin on the same vif, or frames get doubled.
function mtwifi_set_hairpin_phy(vifs, main_ifname)
    local phy = get_phy_name(main_ifname)
    if not phy then return end
    -- radio-global policy: as long as ANY bss explicitly opts out, disable.
    local mode = "1"
    for _, v in ipairs(vifs) do
        if v.config and v.config.hairpin == "0" then
            mode = "0"
            break
        end
    end

    os.execute("mwctl phy "..phy.." set hairpin_mode "..mode.." 2>/dev/null")
    nixio.syslog("info", "mtwifi-cfg: hairpin_mode "..mode.." on "..phy)
end

-- ============================================================
-- mtk service_misc
-- ============================================================
local function find_first_card_profile()
    local best_name, best_path = nil, nil
    for name, dev in pairs(l1dat.devname_ridx) do
        if dev.profile_path then
            if not best_name or name < best_name then
                best_name = name
                best_path = dev.profile_path
            end
        end
    end
    return best_path
end

function mtwifi_service_misc()
    local mapd_default = utils.load_profile("/etc/map/mapd_default.cfg") or {}
    local mapd_user    = utils.load_profile("/etc/map/mapd_user.cfg") or {}
    local first_card   = find_first_card_profile()
    local first_card_cfgs = first_card and utils.load_profile(first_card) or {}

    if utils.exists("/usr/bin/wapp_openwrt.sh") then
        os.execute("/etc/init.d/wapp start")
    end

    if not utils.exists("/usr/bin/EasyMesh_openwrt.sh") then
        return
    end

    if mapd_default.mode then
        local eth_mode    = mapd_user.mode or mapd_default.mode
        local device_role = mapd_user.DeviceRole or mapd_default.DeviceRole

        if first_card_cfgs.MapMode == "1" then
            if (eth_mode == "0" and device_role == "1") or eth_mode == "1" then
                os.execute("/etc/init.d/easymesh start")
            else
                os.execute("/etc/init.d/easymesh_bridge start")
            end
        elseif first_card_cfgs.MapMode ~= "0" then
            os.execute("/etc/init.d/easymesh start")
        end
    else
        os.execute("/etc/init.d/easymesh start")
    end
end

function mtwifi_service_misc_clean()
    os.execute("rm -rf /tmp/wapp_ctrl")
    os.execute("killall -15 mapd 2>/dev/null")
    os.execute("killall -15 wapp 2>/dev/null")
    os.execute("killall -15 p1905_managerd 2>/dev/null")
    os.execute("killall -15 bs20 2>/dev/null")
end

-- ============================================================
-- ifup / ifdown
-- ============================================================
function ifup(ifname)
    if not ifname or #ifname == 0 then return end

    os.execute("ip link set " .. ifname .. " up")
    nixio.syslog("info", "mtwifi-cfg: ip link set up " .. ifname)
end

function ifdown(ifname)
    if not ifname or #ifname == 0 then return end

    os.execute("ip link set " .. ifname .. " down")
    nixio.syslog("info", "mtwifi-cfg: ip link set down " .. ifname)
end

-- ============================================================
-- .dat
-- ============================================================
function cfg2dat(cfg)
    if type(cfg) == type(true) then
        if cfg then return 1 else return 0 end
    elseif type(cfg) == type(0) or type(cfg) == type("") then
        return cfg
    end
end

function set_dev_dat(dats, dat, cfg)
    if cfg ~= nil then
        dats[dat] = cfg2dat(cfg)
    end
end

function set_dat(dats, apidx, dat, cfg)
    if cfg ~= nil then
        dats[dat] = utils.token_set(dats[dat], apidx, cfg2dat(cfg))
    end
end

function set_idx_dat(dats, apidx, dat, cfg)
    if cfg ~= nil then
        dats[dat..tostring(apidx)] = cfg
    end
end

function is_n_mode(cfg)
    return cfg.config.htmode and string.sub(cfg.config.htmode, 1, 2) == "HT"
end

function is_ac_mode(cfg)
    return cfg.config.htmode and string.sub(cfg.config.htmode, 1, 3) == "VHT"
end

function is_ax_mode(cfg)
    return cfg.config.htmode and string.sub(cfg.config.htmode, 1, 2) == "HE"
end

function is_be_mode(cfg)
    return cfg.config.htmode and string.sub(cfg.config.htmode, 1, 3) == "EHT"
end

function vif_count(cfg)
    local vif_num = 0
    local ap_num = 0
    local apcli_num = 0

    for k,v in pairs(cfg.interfaces) do
        vif_num = vif_num + 1
        if v.config.mode == "ap" then
            ap_num = ap_num + 1
        elseif v.config.mode == "sta" then
            apcli_num = apcli_num + 1
        end
    end

    return vif_num, ap_num, apcli_num
end

function mtwifi_cfg_foreach_vif(cfg, mode, func)
    if cfg == nil or func == nil then return end

    local keys = {}
    for k, _ in pairs(cfg.interfaces) do
        table.insert(keys, k)
    end
    table.sort(keys)

    for _, k in ipairs(keys) do
        local v = cfg.interfaces[k]
        if v and v.config and v.config.mode == mode then
            func(v)
        end
    end
end

function __apcli_auto_connect(ifname)
    __exec_cfg80211_tool(ifname, "ApCliEnable", "1")
    __exec_cfg80211_tool(ifname, "ApCliAutoConnect", "3")
end

function mtwifi_up(devname, cfg, is_dbdc)
    nixio.syslog("info", "mtwifi-cfg: start "..devname)
    local dev = l1dat.devname_ridx[devname]
    if not dev then return end

    if is_dbdc then
        local dbdc_main_dev = dev.INDEX .. "_1_1"
        local dbdc_main_ifname = l1dat.devname_ridx[dbdc_main_dev].main_ifname

        if not is_dbdc_inited(dbdc_main_ifname) then
            nixio.syslog("info", "mtwifi-cfg: dbdc card init...")
            ifup(dbdc_main_ifname)
            utils.sleep(1)
            ifdown(dbdc_main_ifname)
        end
    end

    for _, v in pairs(cfg.interfaces) do
        if v.config and type(v.config.network) == "table" then
            v.config.network = v.config.network[1] or "lan"
        end
    end

    -- PHY 级 hairpin（radio-global，一个 PHY 设一次）
    local ap_vifs = {}
    mtwifi_cfg_foreach_vif(cfg, "ap", function(v)
        if not v.config.disabled and v.mtwifi_ifname then
            table.insert(ap_vifs, v)
        end
    end)
    if #ap_vifs > 0 then
        mtwifi_set_hairpin_phy(ap_vifs, dev.main_ifname)
    end

    mtwifi_set_mld_bcn_up(cfg)
    mtwifi_service_misc()
    mtwifi_set_mgmt_rx_accept_all(cfg.device)
    mtwifi_cfg_cfg80211_tool_hook(cfg)
end

function mtwifi_down(devname, cfg)
    nixio.syslog("info", "mtwifi-cfg: stop "..devname)

    mtwifi_service_misc_clean()
    mtwifi_set_mgmt_rx_accept_beacon_probrsp(devname)

    return {}
end

function mtwifi_reinstall()
    nixio.syslog("info", "mtwifi-cfg: unload mtwifi module...")

    os.execute("rmmod mtk_warp 2>/dev/null")
    os.execute("rmmod mt_wifi 2>/dev/null")

    utils.sleep(2)

    nixio.syslog("info", "mtwifi-cfg: reload mtwifi module...")

    os.execute("modprobe mt_wifi")
    os.execute("modprobe mtk_warp")

    utils.sleep(1)
end

function cfg80211_tool()
    if utils.exists("/usr/sbin/mwctl") then
        return "mwctl"
    elseif utils.exists("/usr/sbin/iwpriv") then
        return "iwpriv"
    end
    return nil
end

function __exec_cfg80211_tool(ifname, key, val)
    local tool = cfg80211_tool()
    if tool then
        if type(val) == "boolean" then
            val = val and "1" or "0"
        end
        local cmd = string.format("%s %q set %q=%q", tool, ifname, key, tostring(val))
        nixio.syslog("info", "mtwifi-cfg: cfg80211_tool cmd: "..cmd)
        os.execute(cmd)
    else
        nixio.syslog("err", "mtwifi-cfg: no cfg80211 tool found for "..ifname)
    end
end

function mtwifi_cfg_cfg80211_tool_hook(cfg)
    local ap_hook = function(v)
        if (not v.config.disabled) and v.mtwifi_ifname then
            local vif = v.mtwifi_ifname
            for k, j in pairs(defs.cfg80211_tool_ap_cfgs) do
                local val
                if k == "mwds" then
                    val = (v.config.mwds == "1") and "1" or "0"
                else
                    val = v.config[k] or j[2]
                end
                __exec_cfg80211_tool(vif, j[1], val)
            end
            if v.config.multi_ap == "1" or v.config.multi_ap == "2" then
                if v.config.isolate == "1" then
                    nixio.syslog("err", "mtwifi-cfg: multi_ap backhaul cannot combine with isolate_clients; ignoring multi_ap for "..vif)
                else
                    __exec_cfg80211_tool(vif, "fhbss", (v.config.multi_ap == "2") and "0" or "1")
                    __exec_cfg80211_tool(vif, "bhbss", (v.config.multi_ap == "2") and "1" or "0")
                end
            end
        end
    end
    local apcli_hook = function(v)
        if (not v.config.disabled) and v.mtwifi_ifname then
            local vif = v.mtwifi_ifname
            if v.config.mwds ~= nil then
                __exec_cfg80211_tool(vif, "mwds enable",
                    v.config.mwds ~= "0" and "1" or "0")
            end
            --__apcli_auto_connect(vif)
        end
    end

    mtwifi_cfg_foreach_vif(cfg, "ap", ap_hook)
    mtwifi_cfg_foreach_vif(cfg, "sta", apcli_hook)
end

function set_chip_cfg(cfg, dats)
    local dev_dats
    local uci
    local dat_key

    if not cfg.config.dbdc_main then return end

    for k,v in pairs(defs.chip_cfgs) do
        uci = k
        dat_key = v[1]

        dats[dat_key] = v[2]

        set_dev_dat(dats, dat_key, cfg.config[uci])
    end

    for k,v in pairs(l1dat.devname_ridx) do
        if k ~= cfg.device and
        v.INDEX == l1dat.devname_ridx[cfg.device].INDEX and
        v.mainidx == l1dat.devname_ridx[cfg.device].mainidx then
            dev_dats = utils.load_profile(v.profile_path)
            if dev_dats then
                for _,j in pairs(defs.chip_cfgs) do
                    dat_key = j[1]
                    set_dev_dat(dev_dats, dat_key, dats[dat_key])
                end
                save_profile(dev_dats, v.profile_path)
            end
        end
    end
end

-- band:"2g" or "5g/6g", legacy_rates: 0/1, cell_density: 0~3
-- UpdateBasicRateBitmap function in mlme.c of the mt_wifi driver,
-- force to 6,12,24M(336) in a-band/GN_MIXMODE.
local function get_basic_rate(band, cell_density, legacy_rates, w_mode)
    cell_density = tonumber(cell_density) or 0
    local rate_map = { [0]=336, 336, 320, 256 }
    if band == "2g" then
        if legacy_rates == 0 and cell_density == 0 then
            if w_mode == 1 then     -- B only
                return 3
            elseif w_mode == 4 then -- G only
                return 351
            else -- N only (2.4G)/-- B/G/N mixed
                return 15
            end
        elseif legacy_rates == 1 and cell_density <= 2 then
            return ({15, 12, 8})[cell_density + 1] or 15
        end
    end
    return rate_map[cell_density] or 336
end

function mtwifi_cfg_setup(argv)
    if utils.exists(REINSTALL_LOCK) then
        nixio.syslog("warning", "mtwifi-cfg: reinstall in progress, skip nested setup")
        return
    end

    local cfg = cjson.decode(argv)

    utils.log2file("input = " .. inspect(cfg))

    update_iface_wps(cfg)

    local devname = cfg.device
    local dev = l1dat.devname_ridx[devname]

    if not dev then return end

    local profile = dev.profile_path

    local dats = utils.load_profile(profile)
    if not dats then
        nixio.syslog("err", "mtwifi-cfg: profile ".. profile .. "open failed")
        return
    end
    local dats_orig = utils.load_profile(profile)

    local vif_num, bssid_num, apcli_num = vif_count(cfg)

    if vif_num == 0 then
        nixio.syslog("err", "mtwifi-cfg: not valid vif found!")
        return
    end
    if bssid_num > defs.max_mbssid then
        nixio.syslog("err", "mtwifi-cfg: too many mbssid vifs!")
        return
    end
    if apcli_num > 1 then
        nixio.syslog("err", "mtwifi-cfg: only support one apcli vif! aborting setup")
        return
    end

    --dats.BssidNum = 8
    if bssid_num > 0 then
        dats.BssidNum = bssid_num
    else
        dats.BssidNum = 1
    end

    if type(cfg.config.htmode) ~= type("") then
        nixio.syslog("err", "mtwifi-cfg: invalid htmode!")
        return
    end

    local WirelessMode
    local band = cfg.config.band
    local require_mode = cfg.config.require_mode

    if band == "2g" then
        if is_be_mode(cfg) or require_mode == "be" then
            WirelessMode = 22 -- PHY_11BE_24G
        elseif is_ax_mode(cfg) or require_mode == "ax" then
            WirelessMode = 16 -- PHY_11AX_24G
        elseif is_n_mode(cfg) or require_mode == "n" then
            WirelessMode = 9 -- PHY_11BGN_MIXED
        else
            WirelessMode = 4 -- PHY_11G
        end
    elseif band == "5g" then
        if is_be_mode(cfg) or require_mode == "be" then
            WirelessMode = 23 -- PHY_11BE_5G
        elseif is_ax_mode(cfg) or require_mode == "ax" then
            WirelessMode = 17 -- PHY_11AX_5G
        elseif is_ac_mode(cfg) or require_mode == "ac" then
            WirelessMode = 14 -- PHY_11VHT_N_A_MIXED
        elseif is_n_mode(cfg) or require_mode == "n" then
            WirelessMode = 8 -- PHY_11AN_MIXED
        else
            WirelessMode = 2 -- PHY_11A
        end
    elseif band == "6g" then
        if is_be_mode(cfg) or require_mode == "be" then
            WirelessMode = 24 -- PHY_11BE_6G
        elseif is_ax_mode(cfg) or require_mode == "ax" then
            WirelessMode = 18 -- PHY_11AX_6G
        end
    end

    if not WirelessMode then
        nixio.syslog("err", "mtwifi-cfg: invalid wireless mode!")
        return
    end

    local bw = string.match(cfg.config.htmode, "%d+")
    if not bw then
        nixio.syslog("err", "mtwifi-cfg: invalid bandwidth!")
        return
    end

    dats.HT_BW = 0
    dats.VHT_BW = 0
    dats.EHT_ApBw = 0

    if bw == "40" then
        dats.HT_BW = 1
        dats.VHT_BW = 0
        dats.EHT_ApBw = 1
        dats.HT_BSSCoexistence = not cfg.config.noscan and 1 or 0
    elseif bw == "80" then
        dats.HT_BW = 1
        dats.VHT_BW = 1
        dats.EHT_ApBw = 2
    elseif bw == "160" then
        dats.HT_BW = 1
        dats.VHT_BW = 2
        dats.EHT_ApBw = 3
    elseif bw == "320" and band == "6g" then
        dats.HT_BW = 1
        dats.VHT_BW = 2
        if is_be_mode(cfg) then
            dats.EHT_ApBw = 4
        elseif is_ax_mode(cfg) then
            dats.EHT_ApBw = 3
        end
    end

    -- setup apcli
    dats.ApCliWirelessMode = ""
    dats.ApCliEnable = 0
    dats.ApCliSsid = ""
    dats.AutoConnect = 0
    dats.ApCliBssid = ""
    dats.MACRepeaterEn = 0
    dats.ApcliMloDisable = 1
    dats.ApcliMldAddr = ""
    dats.ApCliMWDS = 0
    dats.ApCliUAPSDCapable = 0
    dats.ApcliMacAddress = ""
    dats.ApCliAuthMode = ""
    dats.ApCliEncrypType = ""
    dats.ApCliWPAPSK = ""
    dats.ApCliPMFMFPC = 0
    dats.ApCliPMFMFPR = 0
    dats.ApCliPMFSHA256 = 0
    dats.ApCliPweMethod = 0
    dats.ApCliPMFSAQ_Time = 1000
    dats.ApCliPMFSAQ_ConfTime = 200
    dats.ApCliOCVSupport = 0
    dats.ApCliMuMimoDlEnable = 0
    dats.ApCliMuMimoUlEnable = 0
    dats.ApCliMuOfdmaDlEnable = 1
    dats.ApCliMuOfdmaUlEnable = 1
    dats.ApCliPpMuMimoDlEnable = 0
    dats.ApCliPpMuMimoUlEnable = 0
    dats.ApCliPpOfdmaDlEnable = 1
    dats.ApCliPpOfdmaUlEnable = 1

    for _,v in pairs(cfg.interfaces) do
        if v.config and v.config.mode == "sta" then
            dats.ApCliWirelessMode = WirelessMode
            if not v.config.disabled then
                dats.ApCliEnable = 1
                if not v.config.mldgroup then
                    dats.ApcliMloDisable = 1
                    dats.ApcliMacAddress = v.config.macaddr
                else
                    dats.ApcliMloDisable = 0
                    dats.ApcliMldAddr = v.config.macaddr
                end
            end

            if v.config.mwds then
                dats.ApCliMWDS = v.config.mwds and 1 or 0
                __exec_cfg80211_tool(v.mtwifi_ifname, "mwds enable", v.config.mwds and "1" or "0")
            end

            dats.ApCliSsid = v.config.ssid or ""
            dats.AutoConnect = (v.config.ssid and v.config.ssid ~= "") and 0 or 1
            dats.ApCliBssid = v.config.bssid or ""
            dats.MACRepeaterEn = (v.config.bssid and v.config.bssid ~= "") and 1 or 0
            dats.ApCliUAPSDCapable = v.config.uapsd or 0

            local enc = v.config.encryption
            if enc == "sae" or enc == "sae+ccmp" or enc == "sae+gcmp" or enc == "sae+ccmp256" or enc == "sae+gcmp256" then
                dats.ApCliAuthMode = defs.apclienc2dat[enc][1]
                dats.ApCliEncrypType = defs.apclienc2dat[enc][2]
            else
                dats.ApCliAuthMode = defs.enc2dat[enc][1]
                dats.ApCliEncrypType = defs.enc2dat[enc][2]
            end
            dats.ApCliWPAPSK = v.config.key or ""

            local w_mode = dats.ApCliWirelessMode
            if (w_mode >= 16 and w_mode <= 21) then
                dats.ApCliMuMimoDlEnable = v.config.mumimo_dl and 1 or 0
                dats.ApCliMuMimoUlEnable = v.config.mumimo_ul and 1 or 0
                dats.ApCliMuOfdmaDlEnable = v.config.ofdma_dl and 1 or 0
                dats.ApCliMuOfdmaUlEnable = v.config.ofdma_ul and 1 or 0
            elseif (w_mode >= 22 and w_mode <= 27) then
                dats.ApCliPpMuMimoDlEnable = v.config.mumimo_dl and 1 or 0
                dats.ApCliPpMuMimoUlEnable = v.config.mumimo_ul and 1 or 0
                dats.ApCliPpOfdmaDlEnable = v.config.ofdma_dl and 1 or 0
                dats.ApCliPpOfdmaUlEnable = v.config.ofdma_ul and 1 or 0
            end
            dats.ApCliPweMethod = (w_mode == 18 or w_mode == 24) and 2 or 0

            local ieee80211w = tostring(v.config.ieee80211w)
            if ieee80211w ~= "0" then
                if ieee80211w == "1" or (dats.ApCliAuthMode == "WPA2PSKWPA3PSK" or
                    dats.ApCliAuthMode == "WPA2PSKWPA3PSK,WPA3PSK-EXT") then
                    dats.ApCliPMFMFPC, dats.ApCliPMFMFPR, dats.ApCliPMFSHA256 = 1, 0, 0
                elseif ieee80211w == "2" or (dats.ApCliAuthMode == "OWE" or
                    dats.ApCliAuthMode == "WPA3PSK" or dats.ApCliAuthMode == "WPA3PSK_EXT" or
                    dats.ApCliAuthMode == "WPA3-192" or dats.ApCliAuthMode == "WPA3") then
                    dats.ApCliPMFMFPC, dats.ApCliPMFMFPR = 1, 1
                    dats.ApCliPMFSHA256 = (dats.ApCliAuthMode == "WPA3") and 1 or 0
                end
                dats.ApCliPMFSAQ_Time = v.config.ieee80211w_max_timeout
                dats.ApCliPMFSAQ_ConfTime = v.config.ieee80211w_retry_timeout
                dats.ApCliOCVSupport = v.config.ocv
            else
                dats.ApCliPMFMFPC, dats.ApCliPMFMFPR, dats.ApCliPMFSHA256 = 0, 0, 0
            end
            break
        end
    end

    set_chip_cfg(cfg, dats)

    local country = cfg.config.country

    if type(country) == "string" and #country == 2 then
        dats.CountryCode = country
        if not defs.countryRegions[country] then
            nixio.syslog("err", "mtwifi-cfg: invalid country code " .. country)
            return
        end
        if band == "2g" then
            dats.CountryRegion = defs.countryRegions[country][1]
        elseif band == "5g" then
            dats.CountryRegionABand = defs.countryRegions[country][2]
            if country == "00" or country == "US" then
                dats.AutoChannelSkipList = "100;104;108;112;116;120;124;128;132;136;140;144;169;173;177"
            else
                dats.AutoChannelSkipList = ""
            end
        elseif band == "6g" then
            dats.PweMethod = 2
            dats.CountryRegionABand = defs.countryRegions[country][3]
        end
    end

    if cfg.config.channel == "auto" then
        dats.AutoChannelSelect = 3
        dats.Channel = 0
    else
        dats.AutoChannelSelect = 0
        dats.Channel = cfg.config.channel
    end

    if cfg.config.txpower and cfg.config.txpower < 100 then
        dats.PERCENTAGEenable = 1
        dats.TxPower = cfg.config.txpower
    else
        dats.PERCENTAGEenable = 0
        dats.TxPower = 100
    end

    if cfg.config.mu_beamformer then
        dats.ETxBfEnCond = 1
        dats.MUTxRxEnable = (dats.ApCliEnable == 1) and 3 or 1
        dats.ITxBfEn = 1
    else
        dats.ETxBfEnCond = 0
        dats.MUTxRxEnable = 0
        dats.ITxBfEn = 0
    end

    if cfg.config.twt then
        if is_ax_mode(cfg) then
            dats.TWTSupport = cfg.config.twt
        elseif is_be_mode(cfg) then
            dats.EHT_ApRestrictedTwt = cfg.config.twt
        end
    else
        dats.TWTSupport = 0
        dats.EHT_ApRestrictedTwt = 0
    end

    local region_map = {CN="CHN", US="FCC", JP="JAP", KR="KR", FR="CE", IE="CE", AU="CE"}
    dats.RDRegion = region_map[country] or "CE"

    dats.EDCCARegion = (country == "US" or country == "KR") and 1 or (country == "JP" and 3) or (country == "DE" and 4) or 0

    if cfg.config.doth then
        if band == "2g" then
            dats.SeamlessCSA = 1
        else
            dats.IEEE80211H = 1
        end
        if cfg.config.zw_dfs then
            dats.DfsZeroWait = (dats.MACRepeaterEn == 1) and 0 or 1
            dats.DfsDedicatedZeroWait = 2
            dats.DfsZeroWaitDefault = 1
        end
        dats.DfsEnable = cfg.config.dfs and 1 or 0
    else
        dats.SeamlessCSA = 0
        dats.IEEE80211H = 0
        dats.DfsEnable = 0
        dats.DfsZeroWait = 0
        dats.DfsDedicatedZeroWait = 0
        dats.DfsZeroWaitDefault = 0
    end

    if band == "2g" then
        local whnat = cfg.config.whnat and "1" or "0"
        for f in fs.glob("/etc/wireless/mediatek/mt799*.1*.dat") do
            local content = fs.readfile(f)
            content = content:gsub("WHNAT=[0-9]+", "WHNAT=" .. whnat)
            fs.writefile(f, content)
        end
    end

    -- in mt_wifi cmm_cfg.c set_datcfg_ack_cts_timeout
    dats.ACK_CTS_TOUT_EN = (cfg.config.distance and cfg.config.distance ~= "") and 1 or 0
    dats.Distance = (dats.ACK_CTS_TOUT_EN == 1) and cfg.config.distance or 0
    dats.BasicRate = get_basic_rate(band, cfg.config.cell_density or 0,
                                    cfg.config.legacy_rates and 1 or 0, WirelessMode)
    dats.BGProtection = cfg.config.legacy_rates and 1 or 0
    dats.Vht1024QamSupport = cfg.config.vht_1024 and 1 or 0
    dats.TxBurst = cfg.config.tx_burst and 1 or 0
    dats.TxPreamble = cfg.config.short_preamble and 1 or 0
    dats.HeLdpc = cfg.config.ldpc and 1 or 0

    -- reset vif cfgs to default
    for k,v in pairs(defs.vif_cfgs) do
        dats[k] = ""
        for i = 1, bssid_num do
            dats[k] = utils.token_set(dats[k], i, v)
        end
    end

    for k,v in pairs(defs.vif_cfgs_idx) do
        for i = 1, defs.max_mbssid do
            dats[k..tostring(i)] = ""
        end
        for i = 1, bssid_num do
            dats[k..tostring(i)] = v
        end
    end

    for _, vif_table in ipairs({defs.vif_mac, defs.vif_acl}) do
        for k, v in pairs(vif_table) do
            if k == "MacAddress" then
                for i = 1, bssid_num-1 do
                    dats[k..tostring(i)] = v
                end
                if bssid_num < defs.max_mbssid then
                    for i = bssid_num, defs.max_mbssid-1 do
                        dats[k..tostring(i)] = ""
                    end
                end
            else
                for i = 0, bssid_num-1 do
                    dats[k..tostring(i)] = v
                end
                if bssid_num < defs.max_mbssid then
                    for i = bssid_num, defs.max_mbssid-1 do
                        dats[k..tostring(i)] = ""
                    end
                end
            end
        end
    end

    -- setup vif cfgs
    local apidx = 1
    local ap_index = 0
    local iface_keys = {}
    for k, _ in pairs(cfg.interfaces) do
        table.insert(iface_keys, k)
    end
    table.sort(iface_keys)

    for _, iface_key in ipairs(iface_keys) do
        local v = cfg.interfaces[iface_key]
        if v and v.config and v.config.mode == "ap" then
            local mac = v.config.macaddr
            local mldgroup = v.config.mldgroup
            local igmp_snooping = uci.cursor():get("network", "@device[0]", "igmp_snooping") or ""

            set_dat(dats, apidx, "MldGroup", mldgroup or 0)
            if mldgroup then
                set_idx_dat(dats, apidx-1, "MldAddr", mac or "")
            else
                if ap_index == 0 then
                    dats.MacAddress = mac or dats.MacAddress_Default
                else
                    set_idx_dat(dats, apidx, "MacAddress", mac or "")
                end
            end

            if v.config.mwds then
                set_dat(dats, apidx, "ApMWDS", v.config.mwds and 1 or 0)
                __exec_cfg80211_tool(v.mtwifi_ifname, "mwds enable", v.config.mwds and "1" or "0")
            end

            set_idx_dat(dats, apidx, "SSID", v.config.ssid)
            set_idx_dat(dats, apidx, "WPAPSK", v.config.key or "")
            set_dat(dats, apidx, "NoForwarding", v.config.isolate or 0)
            set_dat(dats, apidx, "HideSSID", v.config.hidden)
            set_dat(dats, apidx, "WmmCapable", v.config.wmm)
            set_dat(dats, apidx, "RekeyInterval", v.config.wpa_group_rekey)
            set_dat(dats, apidx, "HT_AMSDU", v.config.amsdu)
            set_dat(dats, apidx, "HT_AutoBA", v.config.autoba)
            set_dat(dats, apidx, "APSDCapable", v.config.uapsd)
            set_dat(dats, apidx, "RTSThreshold", v.config.rts)
            set_dat(dats, apidx, "FragThreshold", v.config.frag)
            set_dat(dats, apidx, "DtimPeriod", v.config.dtim_period)
            set_dat(dats, apidx, "WirelessMode", WirelessMode)
            set_dat(dats, apidx, "RRMEnable", v.config.ieee80211k)
            set_dat(dats, apidx, "RRMNeighbor", v.config.rrm_neighbor_report)
            set_dat(dats, apidx, "WNMEnable", v.config.bss_transition)
            set_dat(dats, apidx, "WNMNotifyEnable", v.config.wnm_notify)
            set_dat(dats, apidx, "ProxyARPEnable", v.config.proxy_arp)
            set_dat(dats, apidx, "FtSupport", v.config.ieee80211r)
            set_dat(dats, apidx, "FtOtd", v.config.ft_over_ds)
            set_dat(dats, apidx, "IgmpSnEnable", igmp_snooping)
            set_idx_dat(dats, apidx, "FtMdId", v.config.mobility_domain)
            set_idx_dat(dats, apidx, "FtR1khId", v.config.r1_key_holder)
            set_idx_dat(dats, apidx, "R0KeyLifeTime", v.config.r0_key_lifetime)
            set_idx_dat(dats, apidx, "AssocDeadLine", v.config.reassociation_deadline)

            if is_be_mode(cfg) then
                set_dat(dats, apidx, "PpMuMimoDlEnable", v.config.mumimo_dl)
                set_dat(dats, apidx, "PpMuMimoUlEnable", v.config.mumimo_ul)
                set_dat(dats, apidx, "PpOfdmaDlEnable", v.config.ofdma_dl)
                set_dat(dats, apidx, "PpOfdmaUlEnable", v.config.ofdma_ul)
                set_dat(dats, apidx, "HT_BAWinSize", 1024)
            elseif is_ax_mode(cfg) then
                set_dat(dats, apidx, "MuMimoDlEnable", v.config.mumimo_dl)
                set_dat(dats, apidx, "MuMimoUlEnable", v.config.mumimo_ul)
                set_dat(dats, apidx, "MuOfdmaDlEnable", v.config.ofdma_dl)
                set_dat(dats, apidx, "MuOfdmaUlEnable", v.config.ofdma_ul)
                set_dat(dats, apidx, "HT_BAWinSize", 256)
            else
                set_dat(dats, apidx, "HT_BAWinSize", 64)
            end

            if v.config.macfilter then
                if v.config.macfilter == "allow" then
                    set_idx_dat(dats, apidx-1, "AccessPolicy", 1)
                elseif v.config.macfilter == "deny" then
                    set_idx_dat(dats, apidx-1, "AccessPolicy", 2)
                end
            end

            if v.config.maclist then
                local maclist = ""
                for i, v in ipairs(v.config.maclist) do
                    if i > defs.max_acl_entry then
                        break
                    end
                    if #maclist > 0 then
                        maclist = maclist .. ";" .. v
                    else
                        maclist = v
                    end
                end
                set_idx_dat(dats, apidx-1, "AccessControlList", maclist)
            end

            local authmode = defs.enc2dat[v.config.encryption][1]
            set_dat(dats, apidx, "AuthMode", authmode)
            set_dat(dats, apidx, "EncrypType", defs.enc2dat[v.config.encryption][2])

            local wps = tostring(v.config.wps_pushbutton)
            if wps == "1" then
                set_dat(dats, apidx, "WscConfMode", 7)
                set_dat(dats, apidx, "WscConfStatus", 1)
                local pin = v.config.pin or ""
                set_dat(dats, apidx, "Wsc4digitPinCode", #pin <= 4 and 1 or 0)
                set_dat(dats, apidx, "WscVendorPinCode", v.config.pin or "")
            elseif wps == "2" then
                set_dat(dats, apidx, "WscConfMode", 7)
                set_dat(dats, apidx, "WscConfStatus", 2)
            end

            local ieee80211w = tostring(v.config.ieee80211w)
            if ieee80211w ~= "0" then
                if ieee80211w == "1" or (authmode == "WPA2PSKWPA3PSK" or authmode == "WPA2PSKWPA3PSK,WPA3PSK_EXT") then
                    set_dat(dats, apidx, "PMFMFPC", 1)
                    set_dat(dats, apidx, "PMFMFPR", 0)
                    set_dat(dats, apidx, "PMFSHA256", 0)
                elseif ieee80211w == "2" or (authmode == "OWE" or authmode == "WPA3PSK,WPA3PSK_EXT" or
                    authmode == "WPA3PSK_EXT" or authmode == "WPA3PSK" or authmode == "WPA3" or authmode == "WPA3-192") then
                    set_dat(dats, apidx, "PMFMFPC", 1)
                    set_dat(dats, apidx, "PMFMFPR", 1)
                    set_dat(dats, apidx, "PMFSHA256", (authmode == "WPA3") and 1 or 0)
                end
                set_dat(dats, apidx, "PMFSAQ_Time", v.config.ieee80211w_max_timeout)
                set_dat(dats, apidx, "PMFSAQ_ConfTime", v.config.ieee80211w_retry_timeout)
                set_dat(dats, apidx, "OCVSupport", v.config.ocv)
            else
                set_dat(dats, apidx, "PMFMFPC", 0)
                set_dat(dats, apidx, "PMFMFPR", 0)
                set_dat(dats, apidx, "PMFSHA256", 0)
            end

            if not (authmode == "OPEN" or authmode == "OWE") then
                set_dat(dats, apidx, "RekeyMethod", "TIME")
            end

            if authmode == "WPA" or authmode == "WPA2" or authmode == "WPA1WPA2" or
                authmode == "WPA3WPA2" or authmode == "WPA3" or authmode == "WPA3-192" then
                set_idx_dat(dats, apidx, "NasId", v.config.nasid or "")
                set_idx_dat(dats, apidx, "RADIUS_Key", v.config.auth_secret or "")
                set_dat(dats, apidx, "RADIUS_Acct_Key", v.config.acct_secret or "")
                set_dat(dats, apidx, "own_ip_addr", v.config.ownip or "")
                set_dat(dats, apidx, "own_radius_port", v.config.own_radius_port or "")
                set_dat(dats, apidx, "PreAuth", v.config.rsn_preauth)
                set_dat(dats, apidx, "RADIUS_Port", v.config.auth_port)
                set_dat(dats, apidx, "RADIUS_Server", v.config.auth_server)
                set_dat(dats, apidx, "RADIUS_Acct_Server", v.config.acct_server)
                set_dat(dats, apidx, "RADIUS_Acct_Port", v.config.acct_port)
                set_dat(dats, apidx, "IEEE8021X", (authmode == "WPA" or authmode == "WPA2") and 1 or 0)
            else
                set_idx_dat(dats, apidx, "FtR0khId", v.config.nasid or "")
            end

            apidx = apidx + 1
            ap_index = ap_index + 1
        end
    end

    local reinstall_wifidrv = false
    local cfg_diff = diff_cfg(dats_orig, dats)
    utils.log2file("diff = " .. inspect(cfg_diff))

    save_profile(dats, profile)

    for _,v in pairs(defs.reinstall_cfgs) do
        if cfg_diff[v] ~= nil then
            if utils.exists("/sys/module/mt_wifi") == false then
                nixio.syslog("err", "mtwifi-cfg: mtwifi module is build-in, please reboot the device!")
                return
            end
            reinstall_wifidrv = true
        end
    end

    if string.find(profile, "dbdc") then
        if reinstall_wifidrv then
            --nixio.syscall = nixio.syscall or syscall
            local lf = io.open(REINSTALL_LOCK, "w")
            if lf then lf:write(tostring(os.time())); lf:close() end
            local ok = true
            for k, _ in pairs(l1dat.devname_ridx) do
                mtwifi_down(k)
            end

            ok = mtwifi_reinstall()
            if ok then
                for k, _ in pairs(l1dat.devname_ridx) do
                    if k == devname then
                        mtwifi_up(k, cfg, true)
                    else
                        os.execute("/sbin/wifi up " .. k)
                    end
                end
            else
                nixio.syslog("err", "mtwifi-cfg: driver reload failed; reboot recommended")
            end
            os.remove(REINSTALL_LOCK)
        else
            local restart_other_dbdc_dev = false
            if next(cfg_diff) ~= nil then
                restart_other_dbdc_dev = true
            end

            if restart_other_dbdc_dev then
                for k, j in pairs(l1dat.devname_ridx) do
                    if j.INDEX == dev.INDEX and j.mainidx == dev.mainidx then
                        mtwifi_down(k, cfg)
                    end
                end

                for k, j in pairs(l1dat.devname_ridx) do
                    if j.INDEX == dev.INDEX and j.mainidx == dev.mainidx then
                        mtwifi_up(k, cfg, true)
                    end
                end
            else
                mtwifi_down(devname)
                mtwifi_up(devname, cfg, true)
            end
        end
    else
        mtwifi_down(devname)

        if reinstall_wifidrv then
            local lf = io.open(REINSTALL_LOCK, "w")
            if lf then lf:write(tostring(os.time())); lf:close() end
            local ok = mtwifi_reinstall()
            if not ok then
                nixio.syslog("err", "mtwifi-cfg: driver reload failed; reboot recommended")
            end
            os.remove(REINSTALL_LOCK)
        end
        mtwifi_up(devname, cfg)
    end
end

function mtwifi_cfg_down(devname)
    if devname then
        mtwifi_down(devname)
    else
        for k, _ in pairs(l1dat.devname_ridx) do
            mtwifi_down(k)
        end
    end
end

local action = {
    ["down"] = function(devname)
        mtwifi_cfg_down(devname)
    end,

    ["setup"] = function()
        local argv = io.read()
        if #argv > 0 then
            mtwifi_cfg_setup(argv)
        end
    end
}

if #arg == 1 then
    action[arg[1]]()
elseif #arg == 2 then
    action[arg[1]](arg[2])
end
