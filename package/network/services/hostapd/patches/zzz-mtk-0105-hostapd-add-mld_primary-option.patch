From 9aed6af140b54983ed9d4349e15471c0bb082966 Mon Sep 17 00:00:00 2001
From: Michael-CY Lee <michael-cy.lee@mediatek.com>
Date: Tue, 26 Dec 2023 08:05:41 +0800
Subject: [PATCH] mtk: hostapd: add mld_primary option

Signed-off-by: Michael-CY Lee <michael-cy.lee@mediatek.com>
---
 hostapd/config_file.c | 2 ++
 src/ap/ap_config.h    | 3 +++
 2 files changed, 5 insertions(+)

diff --git a/hostapd/config_file.c b/hostapd/config_file.c
index 40b796d6e..fcd30bbd2 100644
--- a/hostapd/config_file.c
+++ b/hostapd/config_file.c
@@ -5213,6 +5213,8 @@ static int hostapd_config_fill(struct hostapd_config *conf,
 		bss->mld_ap = !!atoi(pos);
 	} else if (os_strcmp(buf, "mld_id") == 0) {
 		bss->mld_id = atoi(pos);
+	} else if (os_strcmp(buf, "mld_primary") == 0) {
+		bss->mld_primary = !!atoi(pos);
 	} else if (os_strcmp(buf, "mld_addr") == 0) {
 		if (hwaddr_aton(pos, bss->mld_addr)) {
 			wpa_printf(MSG_ERROR, "Line %d: Invalid mld_addr",
diff --git a/src/ap/ap_config.h b/src/ap/ap_config.h
index bed34397b..d26ca210e 100644
--- a/src/ap/ap_config.h
+++ b/src/ap/ap_config.h
@@ -992,6 +992,9 @@ struct hostapd_bss_config {
 	/* The AP is part of an AP MLD */
 	u8 mld_ap;
 
+	/* The AP is the primary AP of an AP MLD */
+	u8 mld_primary;
+
 	/* The MLD ID to which the AP MLD is affiliated with */
 	u8 mld_id;
 
