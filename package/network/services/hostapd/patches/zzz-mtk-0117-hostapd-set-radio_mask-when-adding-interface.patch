 		wpa_printf(MSG_DEBUG, "Pre-build new interface: %s", ifname);
 		ret = nl80211_create_iface_once(drv, ifname,
 						  NL80211_IFTYPE_AP, NULL, 0,
-						  NULL, NULL);
+						  NULL, NULL, 0);
 		if (ret < 0) {
 			wpa_printf(MSG_ERROR, "Cannot pre-build first interface!");
 			goto failed;
@@ -6597,7 +6597,7 @@ static int nl80211_create_iface_once(struct wpa_driver_nl80211_data *drv,
 				     enum nl80211_iftype iftype,
 				     const u8 *addr, int wds,
 				     int (*handler)(struct nl_msg *, void *),
-				     void *arg)
+				     void *arg, u32 radio_mask)
 {
 	struct nl_msg *msg;
 	int ifidx;
@@ -6609,7 +6609,8 @@ static int nl80211_create_iface_once(struct wpa_driver_nl80211_data *drv,
 	msg = nl80211_cmd_msg(drv->first_bss, 0, NL80211_CMD_NEW_INTERFACE);
 	if (!msg ||
 	    nla_put_string(msg, NL80211_ATTR_IFNAME, ifname) ||
-	    nla_put_u32(msg, NL80211_ATTR_IFTYPE, iftype))
+	    nla_put_u32(msg, NL80211_ATTR_IFTYPE, iftype) ||
+	    nla_put_u32(msg, NL80211_ATTR_VIF_RADIO_MASK, radio_mask))
 		goto fail;
 
 	if (wds && nla_put_u8(msg, NL80211_ATTR_4ADDR, wds))
@@ -6709,12 +6710,12 @@ int nl80211_create_iface(struct i802_bss *bss, struct wpa_driver_nl80211_data *d
 			 const char *ifname, enum nl80211_iftype iftype,
 			 const u8 *addr, int wds,
 			 int (*handler)(struct nl_msg *, void *),
-			 void *arg, int use_existing)
+			 void *arg, int use_existing, u32 radio_mask)
 {
 	int ret;
 
 	ret = nl80211_create_iface_once(drv, ifname, iftype, addr, wds, handler,
-					arg);
+					arg, radio_mask);
 
 	/* if error occurred and interface exists already */
 	if (ret == -ENFILE && if_nametoindex(ifname)) {
@@ -6740,7 +6741,7 @@ int nl80211_create_iface(struct i802_bss *bss, struct wpa_driver_nl80211_data *d
 
 		/* Try to create the interface again */
 		ret = nl80211_create_iface_once(drv, ifname, iftype, addr,
-						wds, handler, arg);
