+struct mtk_mlo_fill_arg {
+	struct iwinfo_assoclist_entry *entries;
+	int count;
+};
+
+static void mtk_fill_mlo_entry(struct iwinfo_assoclist_entry *e,
+                               struct nlattr **link_attrs)
+{
+	if (link_attrs[MTK_NL80211_VENDOR_ATTR_CONNECTED_STA_MLD_AFFILIATED_STA_LINKID])
+		e->mlo_link_id = nla_get_u8(
+			link_attrs[MTK_NL80211_VENDOR_ATTR_CONNECTED_STA_MLD_AFFILIATED_STA_LINKID]);
+
+	if (link_attrs[MTK_NL80211_VENDOR_ATTR_CONNECTED_STA_MLD_AFFILIATED_STA_LAST_DL_RATE]) {
+		e->mlo_tx_rate[e->mlo_num_links].rate =
+			nla_get_u32(link_attrs[MTK_NL80211_VENDOR_ATTR_CONNECTED_STA_MLD_AFFILIATED_STA_LAST_DL_RATE]) * 100;
+	}
+	if (link_attrs[MTK_NL80211_VENDOR_ATTR_CONNECTED_STA_MLD_AFFILIATED_STA_LAST_UL_RATE]) {
+		e->mlo_rx_rate[e->mlo_num_links].rate =
+			nla_get_u32(link_attrs[MTK_NL80211_VENDOR_ATTR_CONNECTED_STA_MLD_AFFILIATED_STA_LAST_UL_RATE]) * 100;
+	}
+
+	e->mlo_num_links++;
+	if (e->mlo_num_links > 3) e->mlo_num_links = 3;
+}
+
+static int mtk_mlo_info_cb(struct nl_msg *msg, void *arg)
+{
+	struct mtk_mlo_fill_arg *fill = arg;
+	struct nlattr **tb = nl80211_parse(msg);
+	struct nlattr *mld_attrs[MTK_NL80211_VENDOR_ATTR_CONNECTED_STA_MLD_MAX + 1];
+	struct nlattr *links, *link;
+	int rem;
+	uint8_t *mld_mac = NULL;
+
+	if (!tb[NL80211_ATTR_VENDOR_DATA])
+		return NL_SKIP;
+
+	if (nla_parse_nested(mld_attrs, MTK_NL80211_VENDOR_ATTR_CONNECTED_STA_MLD_MAX,
+	                     tb[NL80211_ATTR_VENDOR_DATA], NULL))
+		return NL_SKIP;
+
+	if (mld_attrs[MTK_NL80211_VENDOR_ATTR_CONNECTED_STA_MLD_MAC])
+		mld_mac = nla_data(mld_attrs[MTK_NL80211_VENDOR_ATTR_CONNECTED_STA_MLD_MAC]);
+
+	if (mld_attrs[MTK_NL80211_VENDOR_ATTR_CONNECTED_STA_MLD_AFFILIATED_STA]) {
+		links = mld_attrs[MTK_NL80211_VENDOR_ATTR_CONNECTED_STA_MLD_AFFILIATED_STA];
+		nla_for_each_nested(link, links, rem) {
+			struct nlattr *lk[MTK_NL80211_VENDOR_ATTR_CONNECTED_STA_MLD_MAX + 1] = {0};
+			nla_parse_nested(lk, MTK_NL80211_VENDOR_ATTR_CONNECTED_STA_MLD_MAX, link, NULL);
+
+			if (lk[MTK_NL80211_VENDOR_ATTR_CONNECTED_STA_MLD_AFFILIATED_STA_MAC]) {
+				uint8_t *link_mac = nla_data(
+					lk[MTK_NL80211_VENDOR_ATTR_CONNECTED_STA_MLD_AFFILIATED_STA_MAC]);
+				int i;
+				for (i = 0; i < fill->count; i++) {
+					if (memcmp(fill->entries[i].mac, link_mac, 6) == 0) {
+						fill->entries[i].mlo_enable = 1;
+						if (mld_mac)
+							memcpy(fill->entries[i].mld_mac, mld_mac, 6);
+						mtk_fill_mlo_entry(&fill->entries[i], lk);
+						break;
+					}
+				}
+			}
+		}
+	}
+
+	return NL_SKIP;
+}
+
+static void nl80211_fill_mlo_info(const char *ifname,
+                                  struct iwinfo_assoclist_entry *entries,
+                                  int count)
+{
+	struct nl80211_msg_conveyor *cv;
+	unsigned int ifidx = 0;
+	int phyidx = -1;
+
+	if (count <= 0)
+		return;
+
+	if (!strncmp(ifname, "mon.", 4))
+		ifidx = if_nametoindex(&ifname[4]);
+	else if (nl80211_is_ifname(ifname))
+		ifidx = if_nametoindex(ifname);
+	else {
+		phyidx = nl80211_phy_idx_from_phy(ifname);
+		if (phyidx < 0)
+			phyidx = nl80211_phy_idx_from_uci(ifname);
+	}
+
+	if (ifidx <= 0 && phyidx < 0)
+		return;
+
+	cv = nl80211_new(nls->nl80211, NL80211_CMD_VENDOR, 0);
+	if (!cv)
+		return;
+
+	NLA_PUT_U32(cv->msg, NL80211_ATTR_VENDOR_ID, MTK_NL80211_VENDOR_ID);
+	NLA_PUT_U32(cv->msg, NL80211_ATTR_VENDOR_SUBCMD,
+			MTK_NL80211_VENDOR_SUBCMD_GET_CONNECTED_STA_MLD);
+
+	if (ifidx > 0)
+		NLA_PUT_U32(cv->msg, NL80211_ATTR_IFINDEX, ifidx);
+	else if (phyidx >= 0)
+		NLA_PUT_U32(cv->msg, NL80211_ATTR_WIPHY, phyidx);
+
+	NLA_PUT_U8(cv->msg, MTK_NL80211_VENDOR_ATTR_AP_MLD_INDEX_TO_DUMP, 0);
+
+	{
+		struct mtk_mlo_fill_arg arg = { .entries = entries, .count = count };
+		nl80211_send(cv, mtk_mlo_info_cb, &arg);
+	}
+	return;
+
+nla_put_failure:
+	nl80211_free(cv);
+}
