From 0be87a7f24767349b3f551d0f8daa2b39b208ce9 Mon Sep 17 00:00:00 2001
From: Fang Zhao <fang.zhao@mediatek.com>
Date: Mon, 7 Jul 2025 15:58:56 +0800
Subject: [PATCH] add aid support in station info for hostapd WDS.
---
 include/net/cfg80211.h | 1 +
 net/wireless/nl80211.c | 6 ++++++
 2 files changed, 7 insertions(+)
Index: backports-6.18/include/net/cfg80211.h
===================================================================
--- backports-6.18.orig/include/net/cfg80211.h
+++ backports-6.18/include/net/cfg80211.h
@@ -2311,6 +2311,7 @@ struct station_info {
 
 	u16 valid_links;
 	struct link_station_info *links[IEEE80211_MLD_MAX_NUM_LINKS];
+	u16 aid;
 };
 
 /**
Index: backports-6.18/net/wireless/nl80211.c
===================================================================
--- backports-6.18.orig/net/wireless/nl80211.c
+++ backports-6.18/net/wireless/nl80211.c
@@ -7652,6 +7652,12 @@ static int nl80211_send_station(struct s
 		nla_nest_end(msg, links);
 	}
 
+	if (sinfo->aid) {
+		if (nla_put_u16(msg, NL80211_ATTR_STA_AID,
+		    	sinfo->aid))
+			goto nla_put_failure;
+	}
+
 	cfg80211_sinfo_release_content(sinfo);
 	genlmsg_end(msg, hdr);
 	return 0;
